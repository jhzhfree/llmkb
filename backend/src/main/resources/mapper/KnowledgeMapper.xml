<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jh.knowledgeos.mapper.KnowledgeMapper">
 <insert id="insertCard" parameterType="com.jh.knowledgeos.domain.KnowledgeCard" useGeneratedKeys="true" keyProperty="id">INSERT INTO t_knowledge_card(knowledge_code,knowledge_base_id,type,title,summary,content,confidence,status,version) VALUES(#{knowledgeCode},#{knowledgeBaseId},#{type},#{title},#{summary},#{content},#{confidence},#{status},#{version})</insert>
 <insert id="insertClaim" parameterType="com.jh.knowledgeos.domain.Claim" useGeneratedKeys="true" keyProperty="id">INSERT INTO t_claim(claim_code,knowledge_base_id,subject,predicate,object_value,condition_json,confidence,status) VALUES(#{claimCode},#{knowledgeBaseId},#{subject},#{predicate},#{objectValue},#{conditionJson},#{confidence},#{status})</insert>
 <select id="listCards" resultType="com.jh.knowledgeos.domain.KnowledgeCard">SELECT * FROM t_knowledge_card WHERE knowledge_base_id=#{knowledgeBaseId} ORDER BY id DESC</select>
 <select id="listClaims" resultType="com.jh.knowledgeos.domain.Claim">SELECT * FROM t_claim WHERE knowledge_base_id=#{knowledgeBaseId} ORDER BY id DESC</select>
 <update id="updateCardStatus">UPDATE t_knowledge_card SET status=#{status},updated_time=NOW() WHERE knowledge_code=#{knowledgeCode}</update>
 <update id="updateClaimStatus">UPDATE t_claim SET status=#{status},updated_time=NOW() WHERE claim_code=#{claimCode}</update>
 <insert id="insertTrace">INSERT INTO t_query_trace(query_id,knowledge_base_id,original_query,trace_json,answer) VALUES(#{queryId},#{knowledgeBaseId},#{query},#{traceJson},#{answer})</insert>
 <select id="getTrace" resultType="map">SELECT * FROM t_query_trace WHERE query_id=#{queryId}</select>
</mapper>
